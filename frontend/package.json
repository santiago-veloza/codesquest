    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.1",
    "codemirror": "^6.0.2",
    "pyodide": "314.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
